{
  "id": "wasm-plasma",
  "name": "Plasma",
  "description": "A moving plasma blended through your colors. Speed sets the flow and direction rotates the field.",
  "isAnimated": true,
  "parameters": [
    {
      "key": "colors",
      "label": "Colors",
      "kind": "ColorList",
      "defaultValue": ["#FF0080", "#00C8FF"],
      "minColors": 1,
      "maxColors": 8
    },
    {
      "key": "speed",
      "label": "Speed",
      "kind": "FloatRange",
      "defaultValue": 1,
      "min": 0.05,
      "max": 10,
      "step": 0.1,
      "unit": "×"
    },
    {
      "key": "angle",
      "label": "Direction",
      "kind": "FloatRange",
      "defaultValue": 0,
      "min": -360,
      "max": 360,
      "step": 1,
      "unit": "°"
    }
  ]
}
