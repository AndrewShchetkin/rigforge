{
  "Urls": "http://127.0.0.1:5757",
  "AllowedHosts": "localhost;127.0.0.1",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Daemon": {
    "AllowedOrigins": [ "http://localhost:5173", "http://127.0.0.1:5173" ]
  },
  "Hardware": {
    "DryRun": false,
    "Nzxt": {
      "Enabled": true,
      "EnableLcd": true,
      "FallbackFanDutyPercent": 60
    },
    "Asus": {
      "Enabled": true,
      "DefaultArgbLedCount": 24,
      "ExtraProductIds": []
    },
    "Nvidia": {
      "Enabled": true
    },
    "KingstonFury": {
      "Enabled": true,
      "MaxFramesPerSecond": 30,
      "BrightnessPercent": 100,
      "CandidateSlots": [ 0, 1, 2, 3 ],
      "RequireSmbiosMatch": true
    }
  },
  "Windows": {
    "EnableLibreHardwareMonitor": true,
    "EnableMotherboardFanControl": true,
    "Capture": {
      "OutputIndex": 0,
      "TargetWidth": 160,
      "MaxFramesPerSecond": 60
    }
  },
  "Rendering": {
    "MaxFramesPerSecond": 60,
    "StaticEffectFramesPerSecond": 10,
    "PreviewFramesPerSecond": 20,
    "KeepAliveInterval": "00:00:02"
  },
  "Telemetry": {
    "PollInterval": "00:00:01",
    "ProviderTimeout": "00:00:00.800",
    "ReadingTimeToLive": "00:00:15"
  },
  "Cooling": {
    "Interval": "00:00:01",
    "FailsafeDutyPercent": 100,
    "SensorStaleAfter": "00:00:05",
    "CriticalLiquidTemperature": 60,
    "MinimumPumpDutyPercent": 30,
    "RefreshInterval": "00:00:30"
  },
  "Lcd": {
    "MaxFramesPerSecond": 10,
    "HistorySamples": 120,
    "KeepAliveInterval": "00:00:10"
  },
  "Storage": {
    "DataDirectory": ""
  }
}
