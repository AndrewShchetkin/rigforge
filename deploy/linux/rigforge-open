#!/usr/bin/env bash
# Opens the RigForge dashboard, starting the user daemon first when it is not already up.
set -euo pipefail

HEALTH_URL="http://127.0.0.1:5757/api/health"
DASHBOARD_URL="http://127.0.0.1:5757/#/dashboard"

health_ok() {
  if command -v curl >/dev/null 2>&1; then
    curl -fsS --max-time 2 "${HEALTH_URL}" >/dev/null 2>&1
    return
  fi
  if command -v wget >/dev/null 2>&1; then
    wget -q -T 2 -O /dev/null "${HEALTH_URL}" >/dev/null 2>&1
    return
  fi
  return 1
}

if ! health_ok; then
  systemctl --user start rigforge.service || true
  for _ in $(seq 1 30); do
    if health_ok; then
      break
    fi
    sleep 0.5
  done
fi

if ! health_ok; then
  echo "RigForge did not become ready at ${HEALTH_URL}." >&2
  exit 1
fi

if command -v xdg-open >/dev/null 2>&1; then
  xdg-open "${DASHBOARD_URL}"
else
  echo "Open ${DASHBOARD_URL}"
fi
