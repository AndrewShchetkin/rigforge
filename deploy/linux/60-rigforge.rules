# RigForge: user-mode access to RGB / cooling controllers (generated by rigforge-scan udev).
# hidraw = HID control channel, usb = bulk endpoints (AIO screens via libusb).

# Logitech Lightsync
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="0aaa|c07d|c084|c088|c08b|c08c|c092|c094|c336|c339|c33f|c342", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="0aaa|c07d|c084|c088|c08b|c08c|c092|c094|c336|c339|c33f|c342", TAG+="uaccess"

# Gigabyte RGB Fusion 2.0
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="048d", ATTRS{idProduct}=="5702|5711|8297", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="048d", ATTRS{idProduct}=="5702|5711|8297", TAG+="uaccess"

# ASUS Aura USB mainboard controllers
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="1867|1872|18a3|18a5|18f3|1939|19af|1aa6|1bed", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="1867|1872|18a3|18a5|18f3|1939|19af|1aa6|1bed", TAG+="uaccess"

# Lian Li UNI HUB
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0cf2", ATTRS{idProduct}=="a100|a101|a102|a103|a104|a105", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0cf2", ATTRS{idProduct}=="a100|a101|a102|a103|a104|a105", TAG+="uaccess"

# MSI Mystic Light (alternate vendor)
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0db0", ATTRS{idProduct}=="0076|7c75|7c84|7c90|7c91|7c94|7c95|7d06|7d09|7d25|7d32|7d70|7d75|7d77|7d78|7d96|7e06|7e12|7e16|7e26", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0db0", ATTRS{idProduct}=="0076|7c75|7c84|7c90|7c91|7c94|7c95|7d06|7d09|7d25|7d32|7d70|7d75|7d77|7d78|7d96|7e06|7e12|7e16|7e26", TAG+="uaccess"

# MSI Mystic Light
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1462", ATTRS{idProduct}=="0076|7c75|7c84|7c90|7c91|7c94|7c95|7d06|7d09|7d25|7d32|7d70|7d75|7d77|7d78|7d96|7e06|7e12|7e16|7e26", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1462", ATTRS{idProduct}=="0076|7c75|7c84|7c90|7c91|7c94|7c95|7d06|7d09|7d25|7d32|7d70|7d75|7d77|7d78|7d96|7e06|7e12|7e16|7e26", TAG+="uaccess"

# Razer Chroma
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="0078|0084|008a|024e|0258|0c00|0f1f", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="0078|0084|008a|024e|0258|0c00|0f1f", TAG+="uaccess"

# Corsair Lighting Node and Commander Core
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="0c0b|0c10|0c1a|0c1c|0c1e|0c2a|0c32", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1b1c", ATTRS{idProduct}=="0c0b|0c10|0c1a|0c1c|0c1e|0c2a|0c32", TAG+="uaccess"

# NZXT: Kraken coolers, RGB & Fan Controllers, HUE 2
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1e71", ATTRS{idProduct}=="2001|2002|2005|2006|2007|2009|200b|200d|200e|200f|2010|2011|2012|2014|2019|201b|201f|2020|2021|2022|3008|300c|300e|3012|3014", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1e71", ATTRS{idProduct}=="2001|2002|2005|2006|2007|2009|200b|200d|200e|200f|2010|2011|2012|2014|2019|201b|201f|2020|2021|2022|3008|300c|300e|3012|3014", TAG+="uaccess"

# Cooler Master ARGB
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="2516", ATTRS{idProduct}=="0173|1011", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="2516", ATTRS{idProduct}=="0173|1011", TAG+="uaccess"

# ASRock Polychrome USB
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="26ce", ATTRS{idProduct}=="01a2", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="26ce", ATTRS{idProduct}=="01a2", TAG+="uaccess"

# QMK / Vial raw HID on interface 1 (usage page 0xFF60 is not a udev match).
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ENV{ID_USB_INTERFACE_NUM}=="01", TAG+="uaccess"

# i2c-dev adapters: chipset SMBus (DDR4/DDR5 RGB DRAM) and the internal GPU I2C RGB adapter of NVIDIA cards
# (ASUS Aura / MSI Mystic Light / Gigabyte RGB Fusion GPU). RigForge only opens the PCI-scoped internal port-1 adapter
# and never monitor DDC buses; every transfer is limited to 0x60..0x77 by the GPU I2C address firewall.
KERNEL=="i2c-[0-9]*", SUBSYSTEM=="i2c-dev", TAG+="uaccess"

# Read-only SMBIOS/DMI so a non-root process can match DIMM identity before any SMBus traffic.
# Kingston writes 0x08=0x53 and ENE writes pointer register 0x00; without a matched module the bus stays closed.
SUBSYSTEM=="dmi", KERNEL=="id", MODE="0444", TAG+="uaccess"
ACTION=="add", SUBSYSTEM=="dmi", KERNEL=="id", RUN+="/bin/chmod a+r /sys/firmware/dmi/tables/DMI /sys/firmware/dmi/tables/smbios_entry_point"

# Optional: allow members of group "rigforge" to drive motherboard PWM outputs through hwmon.
# ACTION=="add", SUBSYSTEM=="hwmon", RUN+="/bin/sh -c 'chgrp rigforge /sys%p/pwm* && chmod g+w /sys%p/pwm*'"
