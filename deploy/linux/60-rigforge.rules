# RigForge: user-mode access to RGB / cooling controllers (generated by rigforge-scan udev).
# hidraw = HID control channel, usb = bulk endpoints (AIO screens via libusb).

# NZXT: Kraken coolers, RGB & Fan Controllers, HUE 2
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1e71", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1e71", TAG+="uaccess"

# ASUS Aura USB mainboard controllers
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="18f3|1939|19af|1aa6|1bed", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="18f3|1939|19af|1aa6|1bed", TAG+="uaccess"

# Optional: allow members of group "rigforge" to drive motherboard PWM outputs through hwmon.
# ACTION=="add", SUBSYSTEM=="hwmon", RUN+="/bin/sh -c 'chgrp rigforge /sys%p/pwm* && chmod g+w /sys%p/pwm*'"
