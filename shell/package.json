{
  "name": "rigforge-shell",
  "private": true,
  "version": "0.1.0",
  "description": "Native window for the RigForge dashboard.",
  "author": "RigForge",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis dir",
    "dist:dir": "electron-builder --win dir",
    "test": "node --test test/*.test.cjs"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.rigforge.shell",
    "productName": "RigForge",
    "artifactName": "RigForge-Setup-${version}-win-${arch}.${ext}",
    "compression": "maximum",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/rigforge.ico",
        "to": "rigforge.ico"
      }
    ],
    "extraFiles": [
      {
        "from": "../artifacts/stage/win-x64-daemon",
        "to": ".",
        "filter": ["**/*"]
      },
      {
        "from": "../effects",
        "to": "effects",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "icon": "assets/rigforge.ico",
      "executableName": "RigForge",
      "target": ["nsis", "dir"],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RigForge",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "RigForge",
      "include": "build/installer.nsh"
    }
  }
}
